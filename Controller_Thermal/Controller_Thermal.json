{
  "name": "Controller_Thermal",
  "coreType": "zmq",
  "core_init_string": "1",
  "filename": "/path/to/file",
  "loglevel": 5,
  "period": 0.01,
  "simulation_step_time": 1,
  "total_time":  40,
  "num_TurbineGov": 5,
  "endpoints": [
    {
      "name": "Controller_Thermal/channel1",
      "type": "AGC_Thermal",
      "destination": "TransmissionSim",
      "global": true
    }
  ],
  "filters":[
    {
      "names": "filter/channel1",
      "sourcetarget": "Controller_Thermal/channel1",
      "mode": "source",
      "operation": "delay",
      "properties":
      {
        "name": "delay",
        "value": 0.04
      }
    }
  ],
  "publications": {
      "AGC_signal": {
        "pub_interval": 2,
        "element_name": "Controller",
        "element_type": "",
        "topic": "AGC_signal",
        "type": "vector",
        "value": "AGC",
        "unit": "100_MW"
    }
  },
  "subscriptions": {
    "transmission_ACE": {
      "element_name": "",
      "element_type": "",
      "sub_interval": 0.5,
      "topic": "TransmissionSim/ACE",
      "required": true,
      "type": "double",
      "unit": "100_MW",
      "value": "ACE"
    }
  }

}